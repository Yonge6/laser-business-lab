[Unit]
Description=Retry Maker Business Lab Radar deployment after the daily content run

[Timer]
OnCalendar=*-*-* 08:45:00 Asia/Shanghai
OnCalendar=*-*-* 09:15:00 Asia/Shanghai
OnCalendar=*-*-* 10:00:00 Asia/Shanghai
OnCalendar=*-*-* 11:00:00 Asia/Shanghai
Persistent=true
RandomizedDelaySec=120
Unit=maker-business-lab-deploy.service

[Install]
WantedBy=timers.target
