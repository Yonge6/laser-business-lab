# Public site URL used for canonical URLs and sitemap output.
NEXT_PUBLIC_SITE_URL=https://laserbusinesslab.com
NEXT_PUBLIC_BASE_PATH=

# Optional analytics. The site works without these values.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional public endpoints for static hosting. Leave blank for local-only saves/no-op events.
NEXT_PUBLIC_LEAD_ENDPOINT=
NEXT_PUBLIC_EVENT_ENDPOINT=
