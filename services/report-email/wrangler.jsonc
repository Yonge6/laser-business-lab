{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maker-business-lab-report-email",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://maker.wonderelian.com,https://yonge6.github.io,http://127.0.0.1:4173,http://localhost:4173",
    "FROM_EMAIL": "Maker Business Lab <reports@send.wonderelian.com>"
  },
  "ratelimits": [
    {
      "name": "REPORT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
